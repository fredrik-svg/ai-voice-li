[Unit]
Description=Simple Voice Agent (button → webhook)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pi-voice-agent-webhook
ExecStart=/home/pi/pi-voice-agent-webhook/venv/bin/python -m src.agent config.yaml
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
